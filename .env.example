# Copy to .env and edit. Start with the mock backend (no keys, no GPU).

# speech -> text
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# text -> summary: mock | groq | vllm
LLM_BACKEND=mock
# Groq retired Mixtral; the live free default is openai/gpt-oss-120b (free tier).
LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=   # get a free key at console.groq.com, then set LLM_BACKEND=groq
# VLLM_URL=http://localhost:8000/v1   # your own Mixtral server on a GPU box

# summarization
SUMMARY_STRATEGY=map_reduce
MAX_CHUNK_WORDS=1200

UPLOAD_DIR=uploads
JOB_DIR=jobs
